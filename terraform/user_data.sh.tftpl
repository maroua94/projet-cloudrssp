#!/bin/bash
# Installation automatique du site vitrine (premier demarrage uniquement).
# Journal : /var/log/portail-install.log
exec > >(tee -a /var/log/portail-install.log) 2>&1
set -x
export DEBIAN_FRONTEND=noninteractive

echo "== 1. Systeme =="
apt-get update -y
apt-get install -y git curl ca-certificates

echo "== 2. Docker =="
curl -fsSL https://get.docker.com | sh
systemctl enable --now docker

echo "== 3. Code du projet =="
cd /opt
git clone ${repo_url} projet
cd /opt/projet/portail

echo "== 4. Mode public : les outils restent en local =="
sed -i 's/mode: "local"/mode: "public"/' config.js
grep -n 'mode:' config.js

echo "== 5. Portail =="
docker build -t portail .
docker run -d --name portail --restart unless-stopped -p 80:80 portail

echo "== INSTALLATION TERMINEE =="
touch /opt/installation-terminee
